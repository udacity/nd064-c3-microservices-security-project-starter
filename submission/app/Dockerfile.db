FROM postgres:9.6.15-alpine

# Use non-root user for Postgres container to reduce privileges
RUN adduser -D postgresuser && chown -R postgresuser /var/lib/postgresql

USER postgresuser

# Set up database initialization scripts, ensure they are secure
COPY ./migrations/* /docker-entrypoint-initdb.d/

# Set read-only filesystem to limit any unauthorized changes
VOLUME ["/var/lib/postgresql/data"]
RUN chmod -R 700 /docker-entrypoint-initdb.d && chown -R postgresuser /docker-entrypoint-initdb.d
